<section id="estimate-teaser" class="pb-20 sm:pb-28">
  <div class="wrap">
    <div class="relative overflow-hidden rounded-[2rem] border border-cream/10 bg-ink-2 p-6 sm:p-12">
      <div aria-hidden="true" class="pointer-events-none absolute -right-24 -top-24 h-80 w-80 rounded-full bg-lime/10 blur-3xl"></div>
      <div class="relative grid gap-10 lg:grid-cols-12 lg:items-center">
        <div class="lg:col-span-5">
          <h2 class="text-4xl font-bold sm:text-6xl">Grow your <em class="s">quote.</em></h2>
          <p class="mt-4 text-lg text-cream/75">Five taps. A real quote in 24 hours.</p>
        </div>
        <div class="lg:col-span-7">
          <p class="mb-4 text-sm font-medium text-cream/80" id="teaser-q">What should we grow?</p>
          <div class="grid gap-3 sm:grid-cols-2" role="group" aria-labelledby="teaser-q">
            <% content.services().forEach(function (s) { %>
              <a href="/estimate?service=<%= s.key %>" class="group flex items-center justify-between gap-4 rounded-2xl border border-cream/15 bg-ink px-5 py-4 transition-colors duration-200 hover:border-lime" data-service="<%= s.key %>">
                <span class="font-medium"><%= s.label %></span><span class="text-lime transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true">→</span>
              </a>
            <% }) %>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
