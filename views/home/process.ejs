<section id="seasons" class="g-seasons" aria-label="How a project grows: seed, sprout, bloom, harvest">
  <div class="track">
    <div class="stage wrap">
      <%- include('../garden/seasons-svg') %>
      <div>
        <p class="eyebrow">How it grows</p>
        <div class="steps mt-3">
          <div class="step on"><b>Seed</b><span>first call · 1 week</span></div>
          <div class="step"><b>Sprout</b><span>design · 1 to 3 weeks</span></div>
          <div class="step"><b>Bloom</b><span>build &amp; launch · 2 to 4 weeks</span></div>
          <div class="step"><b>Harvest</b><span>leads, every month</span></div>
        </div>
      </div>
    </div>
  </div>
</section>
