<section id="hero" class="hero relative isolate overflow-hidden pb-20 pt-10 sm:pt-16 lg:flex lg:min-h-[calc(100svh-72px)] lg:items-center lg:pb-24 lg:pt-0">
  <div aria-hidden="true" class="hero-grid pointer-events-none absolute inset-0 -z-10"></div>
  <div aria-hidden="true" class="pointer-events-none absolute -left-40 top-1/3 -z-10 h-[560px] w-[560px] rounded-full bg-lime/[0.07] blur-3xl"></div>
  <div class="wrap grid w-full items-center gap-14 lg:grid-cols-12">
    <div class="lg:col-span-7">
      <p class="inline-flex items-center gap-2 rounded-full border border-cream/15 bg-ink-2/70 px-3 py-1.5 text-sm text-cream/80" data-enter data-enter-step="0">
