              <p class="text-[10px] text-cream/70">New season · Shop now</p>
            </div>
          </div>
        </div>
        <div class="absolute -bottom-[4%] left-[6%] rounded-2xl border border-cream/10 bg-ink/90 p-4 shadow-xl shadow-black/50 backdrop-blur" data-enter data-enter-step="4" data-drift="-50">
          <p class="text-[11px] uppercase tracking-wider text-sage">Online appointments</p>
          <p class="mt-1 font-display text-3xl font-bold text-lime">+42%</p>
          <svg class="mt-2 h-8 w-32" viewBox="0 0 128 32" fill="none"><path class="spark" d="M2 28 L22 24 L40 26 L58 17 L76 19 L94 10 L112 8 L126 3" stroke="#C6F432" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
        <div class="absolute right-0 top-0 rounded-full bg-lime px-4 py-2 text-sm font-semibold text-ink shadow-lg" data-enter data-enter-step="5" data-drift="-90">Sample work</div>
      </div>
    </div>
  </div>
</section>
