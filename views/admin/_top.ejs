<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title><%= typeof title !== 'undefined' ? title + ' — ' : '' %>Click & Grow admin</title>
  <link rel="icon" href="/brand/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/app.css">
</head>
<body class="admin min-h-screen bg-ink text-[15px]">
<% if (typeof user !== 'undefined' && user) { %>
<header class="border-b border-cream/10 bg-ink-2">
  <div class="mx-auto flex max-w-7xl flex-wrap items-center gap-x-6 gap-y-2 px-4 py-3">
    <a href="/admin" class="font-display text-lg font-bold">Click <em class="accent text-lime">&amp;</em> Grow <span class="ml-1 text-sm font-normal text-sage">admin</span></a>
    <nav class="flex gap-1 text-sm" aria-label="Admin">
      <a href="/admin" class="rounded-lg px-3 py-2 hover:bg-ink-3<%= typeof nav !== 'undefined' && nav === 'dash' ? ' bg-ink-3' : '' %>">Overview</a>
      <a href="/admin/leads" class="rounded-lg px-3 py-2 hover:bg-ink-3<%= typeof nav !== 'undefined' && nav === 'leads' ? ' bg-ink-3' : '' %>">Leads</a>
      <a href="/" class="rounded-lg px-3 py-2 text-sage hover:bg-ink-3" target="_blank" rel="noopener">View site ↗</a>
    </nav>
    <form action="/admin/logout" method="post" class="ml-auto flex items-center gap-3 text-sm">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <span class="text-sage"><%= user.name %></span>
      <button class="rounded-lg border border-cream/15 px-3 py-1.5 hover:border-cream/40">Sign out</button>
    </form>
  </div>
</header>
<% } %>
<main class="mx-auto max-w-7xl px-4 py-8">
