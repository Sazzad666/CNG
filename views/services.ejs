<%- include('layout/head') %>
<%- include('layout/header') %>
<main id="main">
  <section class="wrap pb-16 pt-16 sm:pt-24">
    <p class="eyebrow" data-enter data-enter-step="0">Services</p>
    <h1 class="mt-4 max-w-4xl text-5xl font-bold sm:text-7xl" data-enter data-enter-step="1">Everything your brand needs to <em class="accent text-lime">grow</em>, under one roof.</h1>
    <p class="mt-6 max-w-2xl text-lg text-cream/75" data-enter data-enter-step="2">One senior team for design, build and marketing, so nothing gets lost between agencies.</p>
  </section>
  <section class="wrap grid gap-6 pb-24 md:grid-cols-2" data-reveal>
    <% content.services().forEach(function (s, i) { %>
      <a href="/services/<%= s.key %>" class="group lift block overflow-hidden rounded-3xl border border-cream/10 bg-ink-2 <%= i === 0 ? 'md:col-span-2' : '' %>" data-reveal-item>
        <div class="zoom relative overflow-hidden <%= i === 0 ? 'aspect-[16/7]' : 'aspect-[16/9]' %>"><%- img(s.photo, { cls: 'absolute inset-0 h-full w-full object-cover', sizes: i === 0 ? '100vw' : '(min-width: 768px) 50vw, 100vw' }) %></div>
        <div class="flex items-start justify-between gap-6 p-6 sm:p-8">
          <div>
            <h2 class="text-3xl font-bold"><%= s.label %></h2>
            <p class="mt-3 max-w-xl text-cream/70"><%= s.intro %></p>
            <ul class="mt-5 flex flex-wrap gap-2">
              <% s.items.slice(0, 5).forEach(function (it) { %><li class="rounded-full border border-cream/15 px-3 py-1 text-sm text-cream/80"><%= it.title %></li><% }) %>
            </ul>
          </div>
          <span class="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-lime text-ink transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true">→</span>
        </div>
      </a>
    <% }) %>
  </section>
  <%- include('partials/cta') %>
</main>
<%- include('layout/footer') %>
<%- include('layout/foot') %>
