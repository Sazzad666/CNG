<dialog id="enquiry-panel" class="enquiry-panel m-0 ml-auto h-[100dvh] max-h-none w-full max-w-[560px] overflow-y-auto bg-ink-2 p-0 text-cream backdrop:bg-ink/70 backdrop:backdrop-blur-sm" aria-labelledby="enquiry-panel-title">
  <div class="flex min-h-full flex-col p-6 sm:p-10">
    <div class="flex items-start justify-between gap-6">
      <div>
        <p class="eyebrow">Start a project</p>
        <h2 id="enquiry-panel-title" class="mt-3 text-3xl font-bold sm:text-4xl">Tell us what you’re <em class="accent text-lime">building.</em></h2>
      </div>
      <button type="button" class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-cream/20 hover:border-cream/60" data-close-panel aria-label="Close">
        <svg class="h-4 w-4" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      </button>
    </div>
    <p class="mt-4 text-cream/70">A senior team member will call you within one business day.</p>
    <div class="mt-8"><%- include('../partials/enquiry-form', { formType: 'enquiry', idp: 'panel' }) %></div>
    <p class="mt-auto pt-8 text-sm text-cream/60">Rather talk now? <a class="ulink text-cream" href="<%= site.phoneHref %>"><%= site.phone %></a> · <a class="ulink text-cream" href="<%= site.whatsapp %>" target="_blank" rel="noopener">WhatsApp</a></p>
  </div>
</dialog>
