<%# Params: p (project), big (bool) %>
<a href="/work/<%= p.slug %>" class="group block lift" data-reveal-item>
  <div class="zoom relative overflow-hidden rounded-3xl bg-ink-2 <%= typeof big !== 'undefined' && big ? 'aspect-[4/3] lg:aspect-[16/10]' : 'aspect-[4/3]' %>">
    <%- img(p.photos[0], { cls: 'absolute inset-0 h-full w-full object-cover', sizes: '(min-width: 1024px) 50vw, 100vw' }) %>
    <div class="absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t from-ink/80 to-transparent"></div>
    <span class="sample-tag absolute left-4 top-4 bg-ink/60 text-cream backdrop-blur">Sample</span>
    <span class="absolute bottom-4 left-4 rounded-full bg-lime px-3 py-1 text-sm font-semibold text-ink"><%= p.result %></span>
  </div>
  <div class="mt-5 flex items-start justify-between gap-4">
    <div>
      <h3 class="font-display text-2xl font-bold"><%= p.client %></h3>
      <p class="mt-1 text-cream/70"><%= p.summary %></p>
    </div>
    <span class="mt-1 inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-cream/20 transition-colors duration-200 group-hover:border-lime group-hover:bg-lime group-hover:text-ink" aria-hidden="true">→</span>
  </div>
</a>
