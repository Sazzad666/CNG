<section id="faq" class="py-20 sm:py-28" data-reveal>
  <div class="wrap grid gap-12 lg:grid-cols-12">
    <div class="lg:col-span-4">
      <p class="eyebrow">Questions</p>
      <h2 class="mt-4 text-4xl font-bold sm:text-5xl">Straight <em class="accent text-lime">answers.</em></h2>
      <p class="mt-5 text-cream/70">Something else on your mind? <a class="ulink text-cream" href="<%= site.phoneHref %>">Call us</a> and ask.</p>
    </div>
    <div class="divide-y divide-cream/10 border-y border-cream/10 lg:col-span-8">
      <% content.faqs().forEach(function (f, i) { %>
        <details class="group faq py-1" <%= i === 0 ? 'open' : '' %>>
          <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 text-lg font-medium [&::-webkit-details-marker]:hidden">
            <%= f.q %>
            <span class="relative h-5 w-5 shrink-0" aria-hidden="true"><span class="absolute left-0 top-1/2 h-0.5 w-5 -translate-y-1/2 bg-lime"></span><span class="absolute left-1/2 top-0 h-5 w-0.5 -translate-x-1/2 bg-lime transition-transform duration-200 group-open:scale-y-0"></span></span>
          </summary>
          <p class="max-w-2xl pb-6 text-cream/75"><%= f.a %></p>
        </details>
      <% }) %>
    </div>
  </div>
</section>
