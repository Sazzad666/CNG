<%# Click & Grow mark: a cursor that clicks, and a sprout grows from its tip. Animated by public/js/logo.js. %>
<a href="/" class="cg-logo group inline-flex items-center gap-2.5 text-cream"<%- typeof animate !== 'undefined' && animate ? ' data-logo-animate' : '' %> aria-label="Click & Grow home page">
  <svg class="cg-mark h-9 w-9 shrink-0 overflow-visible" viewBox="0 0 36 40" aria-hidden="true" focusable="false">
    <circle class="cg-ring" cx="11" cy="15" r="7" fill="none" stroke="#C6F432" stroke-width="1.6" opacity="0"/>
    <path class="cg-stem" d="M11 15 C 11.5 9.5, 14.5 6, 20 4.2" fill="none" stroke="#C6F432" stroke-width="2.2" stroke-linecap="round"/>
    <path class="cg-leaf cg-leaf-a" d="M20 4.2 C 22.5 0.6, 28.5 0.2, 31 2.4 C 28.2 5.6, 23 6.4, 20 4.2 Z" fill="#C6F432"/>
    <path class="cg-leaf cg-leaf-b" d="M12.6 9.6 C 10.2 6.2, 5.6 5.6, 3.4 7.2 C 5.4 10.4, 9.6 11.2, 12.6 9.6 Z" fill="#C6F432"/>
