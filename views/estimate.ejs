<%- include('layout/head') %>
<%- include('layout/header') %>
<main id="main" class="wrap grid gap-12 py-16 sm:py-24 lg:grid-cols-12">
  <div class="lg:col-span-4">
    <p class="eyebrow" data-enter data-enter-step="0">Project estimator</p>
    <h1 class="mt-4 text-5xl font-bold sm:text-6xl" data-enter data-enter-step="1">What would your project <em class="accent text-lime">take?</em></h1>
    <p class="mt-6 text-lg text-cream/75" data-enter data-enter-step="2">Five quick questions. Your custom quote arrives by email within 24 hours, written by a person, not a calculator.</p>
    <ul class="mt-8 space-y-3 text-cream/75" data-enter data-enter-step="3">
      <li class="flex gap-3"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-lime"></span>Takes about a minute</li>
      <li class="flex gap-3"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-lime"></span>No obligation, no spam</li>
    </ul>
  </div>
  <div class="lg:col-span-8">
    <div class="rounded-3xl border border-cream/10 bg-ink-2 p-6 sm:p-10" data-estimator-host>
      <% if (typeof estimator !== 'undefined') { %><%- estimator %><% } else { %>
        <%- include('partials/estimator') %>
      <% } %>
    </div>
  </div>
</main>
<%- include('layout/footer') %>
<%- include('layout/foot') %>
