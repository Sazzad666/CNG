<%- include('layout/head') %>
<%- include('layout/header') %>
<main id="main">
  <section class="wrap grid gap-10 pb-16 pt-16 sm:pt-24 lg:grid-cols-12">
    <div class="lg:col-span-7">
      <p class="eyebrow" data-enter data-enter-step="0">About</p>
      <h1 class="mt-4 text-5xl font-bold sm:text-7xl" data-enter data-enter-step="1">A small senior team in Dhaka, built to help brands <em class="accent text-lime">grow.</em></h1>
    </div>
    <p class="self-end text-lg text-cream/75 lg:col-span-5" data-enter data-enter-step="2">We started Click & Grow because good businesses in Bangladesh deserve the same quality of design and marketing as the world’s best brands, without the runaround.</p>
  </section>
  <div class="wrap" data-enter data-enter-step="2">
    <div class="relative aspect-[21/9] overflow-hidden rounded-3xl"><%- img('dhaka-city', { cls: 'absolute inset-0 h-full w-full object-cover', eager: true }) %></div>
  </div>
  <section class="wrap grid gap-12 py-20 sm:py-28 lg:grid-cols-12" data-reveal>
    <div class="lg:col-span-4"><p class="eyebrow">How we work</p><h2 class="mt-4 text-4xl font-bold sm:text-5xl">What you can hold us to.</h2></div>
    <div class="grid gap-10 sm:grid-cols-3 lg:col-span-8">
      <div data-reveal-item><p class="font-display text-5xl font-bold text-lime">01</p><h3 class="mt-4 text-2xl font-bold">Senior people only</h3><p class="mt-3 text-cream/70">The people you meet in the pitch are the people who do the work, through to launch.</p></div>
      <div data-reveal-item><p class="font-display text-5xl font-bold text-lime">02</p><h3 class="mt-4 text-2xl font-bold">Fixed, clear quotes</h3><p class="mt-3 text-cream/70">You know what you’ll pay and when you’ll launch before we start, and the final invoice matches the quote.</p></div>
      <div data-reveal-item><p class="font-display text-5xl font-bold text-lime">03</p><h3 class="mt-4 text-2xl font-bold">Measured by results</h3><p class="mt-3 text-cream/70">We agree the number that matters up front, and report against it until it moves.</p></div>
    </div>
  </section>
  <section class="py-20 sm:py-28" data-reveal>
    <div class="wrap">
      <p class="eyebrow">The team</p>
      <h2 class="mt-4 text-4xl font-bold sm:text-5xl">The <em class="s">gardeners.</em></h2>
      <div class="mt-12 grid grid-cols-2 gap-6 lg:grid-cols-4">
        <% content.team().forEach(function (m) { %>
          <figure data-reveal-item>
            <div class="relative aspect-[4/5] overflow-hidden rounded-[40%_40%_24px_24px] bg-ink-2 ring-1 ring-lime/20"><%- img(m.photo, { cls: 'absolute inset-0 h-full w-full object-cover', alt: m.name, sizes: '(min-width: 1024px) 25vw, 50vw' }) %></div>
            <figcaption class="mt-4"><span class="block font-display text-xl font-bold"><%= m.name %></span><span class="text-sm text-sage"><%= m.role %></span></figcaption>
          </figure>
        <% }) %>
      </div>
      <p class="mt-8 text-sm text-sage">Team profiles are placeholders until the final team photos are ready.</p>
    </div>
  </section>
  <section class="wrap grid items-center gap-10 py-20 sm:py-28 lg:grid-cols-2" data-reveal>
    <div class="relative aspect-[4/3] overflow-hidden rounded-3xl"><%- img('team-table', { cls: 'absolute inset-0 h-full w-full object-cover', sizes: '(min-width: 1024px) 50vw, 100vw' }) %></div>
    <div>
      <p class="eyebrow">Studio</p>
      <h2 class="mt-4 text-4xl font-bold sm:text-5xl">Based in Dhaka. Working across Bangladesh.</h2>
      <p class="mt-5 text-lg text-cream/75">Meet us at the studio, on a call, or at your office. Most of our clients are in Gulshan, Banani, Dhanmondi and Uttara, and a growing number are abroad.</p>
      <a href="/contact" class="btn btn-lime mt-8" data-open-enquiry>Book a call <span class="arrow" aria-hidden="true">→</span></a>
    </div>
  </section>
</main>
<%- include('layout/footer') %>
<%- include('layout/foot') %>
