{
  "name": "click-and-grow",
  "version": "1.0.0",
  "private": true,
  "description": "Click & Grow — digital agency website (Dhaka) with lead capture and admin inbox",
  "main": "server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build:css": "tailwindcss -i ./src/styles/input.css -o ./public/css/app.css --minify",
    "db:init": "node scripts/db-init.js",
    "create-admin": "node scripts/create-admin.js",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\""
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/inter-tight": "^5.3.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.10",
    "ejs": "^3.1.10",
    "express": "^4.22.3",
    "express-mysql-session": "^3.0.3",
    "express-session": "^1.19.0",
    "gsap": "^3.15.1",
    "helmet": "^8.3.0",
    "motion": "^14.14.0",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.6.1"
  },
  "devDependencies": {
    "sharp": "^0.35.5",
    "supertest": "^7.3.2",
    "tailwindcss": "^3.4.19"
  }
}
